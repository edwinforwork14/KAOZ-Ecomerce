generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  email     String    @unique
  password  String
  phone     String?
  role      String    @default("user")
  address   Json?
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())
  carts     Cart[]
  orders    Order[]

  @@index([email])
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String
  description String?
  image       String?
  level       Int        @default(0)
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  seo         Json?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt @default(now())
  isFeatured  Boolean    @default(false)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]  @relation("MainCategory")
  subProducts Product[]  @relation("SubCategory")

  @@unique([slug, parentId])
  @@index([slug])
  @@index([parentId])
}

model Product {
  id              String           @id @default(uuid())
  name            String
  description     String
  price           Float
  originalPrice   Float?
  priceConfig     Json?
  brand           String           @default("Genérico")
  isNew           Boolean          @default(false)
  markedAsNewAt   DateTime?
  newDurationDays Int?
  isFeatured      Boolean          @default(false)
  isActive        Boolean          @default(true)
  rating          Float            @default(0)
  reviewCount     Int              @default(0)
  viewCount       Int              @default(0)
  addToCartCount  Int              @default(0)
  tags            Json?
  features        Json?
  seo             Json?
  categoryId      String?
  subcategoryId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt @default(now())
  category        Category?        @relation("MainCategory", fields: [categoryId], references: [id])
  subcategory     Category?        @relation("SubCategory", fields: [subcategoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  views           ProductView[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive])
}

model ProductImage {
  id        String          @id @default(uuid())
  url       String
  alt       String?
  isMain    Boolean         @default(false)
  productId String
  variantId String?
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

model ProductVariant {
  id        String         @id @default(uuid())
  color     String         @default("N/A")
  colorHex  String?
  productId String
  images    ProductImage[]
  sizes     ProductSize[]
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSize {
  id        String         @id @default(uuid())
  size      String
  stock     Int            @default(0)
  sku       String?        @unique
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([sku])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String?
  customerInfo    Json
  shippingMethod  Json?
  shippingAddress Json?
  pickupInfo      Json?
  subtotal        Float
  shipping        Float       @default(0)
  total           Float
  totalInBs       Float?
  paymentMethod   Json?
  paymentStatus   String      @default("pending")
  orderStatus     String      @default("pending")
  notes           String?
  adminNotes      String?
  statusHistory   Json?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt @default(now())
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@index([orderNumber])
  @@index([userId])
  @@index([paymentStatus])
  @@index([orderStatus])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  name      String
  image     String?
  color     String?
  size      String?
  quantity  Int
  price     Float
  subtotal  Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt @default(now())
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  name      String
  image     String?
  color     String?
  size      String?
  quantity  Int
  price     Float
  subtotal  Float
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
}

model ExchangeRate {
  id        String   @id @default(uuid())
  usd       Float
  eur       Float
  updatedAt DateTime @updatedAt @default(now())
  createdAt DateTime @default(now())
  date      String   @unique

  @@index([date])
}

model Settings {
  id                 String   @id @default("global")
  currency           Json?
  shippingMethods    Json?
  paymentMethods     Json?
  orders             Json?
  business           Json?
  whatsapp           Json?
  theme              String?  @default("light")
  updatedAt          DateTime @updatedAt @default(now())
  newProductDuration Int      @default(30)
}

model CartHistory {
  id            String   @id @default(uuid())
  userId        String?
  sessionId     String?
  productId     String
  productName   String
  color         String?
  size          String?
  quantity      Int
  price         Float
  originalPrice Float?
  action        String   // "added", "updated", "removed"
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
}

model ProductView {
  id        String   @id @default(uuid())
  productId String
  userId    String?
  sessionId String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([sessionId])
}

model Deployment {
  id          String   @id @default(uuid())
  version     String   @unique
  isActive    Boolean  @default(true)
  deployedAt  DateTime @default(now())
  environment String   @default("development")
  name        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([version])
}

model BulkUploadSession {
  id          String   @id @default(uuid())
  userId      String
  status      String   @default("uploading") // uploading, editing, validating, processing, completed
  drafts      Json?    // Array of product drafts
  assets      Json?    // Map of filenames to URLs
  progress    Int      @default(0)
  totalItems  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([userId])
}
