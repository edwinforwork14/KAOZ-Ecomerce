generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  firstName String
  lastName  String
  email     String    @unique
  password  String
  phone     String?
  role      String    @default("user")
  address   Json?
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt @default(now())
  carts     Cart[]
  orders    Order[]
}

model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  slug        String
  description String?
  image       String?
  level       Int        @default(0)
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  seo         Json?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt @default(now())
  isFeatured  Boolean    @default(false)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]  @relation("MainCategory")
  subProducts Product[]  @relation("SubCategory")

  @@unique([slug, parentId])
}

model Product {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  description     String
  price           Float
  originalPrice   Float?
  priceConfig     Json?
  brand           String           @default("Genérico")
  isNew           Boolean          @default(false)
  markedAsNewAt   DateTime?
  newDurationDays Int?
  isFeatured      Boolean          @default(false)
  isActive        Boolean          @default(true)
  rating          Float            @default(0)
  reviewCount     Int              @default(0)
  viewCount       Int              @default(0)
  addToCartCount  Int              @default(0)
  tags            Json?
  features        Json?
  seo             Json?
  categoryId      String?
  subcategoryId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt @default(now())
  category        Category?        @relation("MainCategory", fields: [categoryId], references: [id])
  subcategory     Category?        @relation("SubCategory", fields: [subcategoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  views           ProductView[]
}

model ProductImage {
  id        String          @id @default(dbgenerated("gen_random_uuid()"))
  url       String
  alt       String?
  isMain    Boolean         @default(false)
  productId String
  variantId String?
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        String         @id @default(dbgenerated("gen_random_uuid()"))
  color     String         @default("N/A")
  colorHex  String?
  productId String
  images    ProductImage[]
  sizes     ProductSize[]
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSize {
  id        String         @id @default(dbgenerated("gen_random_uuid()"))
  size      String
  stock     Int            @default(0)
  sku       String?        @unique
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()"))
  orderNumber     String      @unique
  userId          String?
  customerInfo    Json
  shippingMethod  Json?
  shippingAddress Json?
  pickupInfo      Json?
  subtotal        Float
  shipping        Float       @default(0)
  total           Float
  totalInBs       Float?
  paymentMethod   Json?
  paymentStatus   String      @default("pending")
  orderStatus     String      @default("pending")
  notes           String?
  adminNotes      String?
  statusHistory   Json?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt @default(now())
  user            User?       @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()"))
  orderId   String
  productId String
  name      String
  image     String?
  color     String?
  size      String?
  quantity  Int
  price     Float
  subtotal  Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(dbgenerated("gen_random_uuid()"))
  userId    String?
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt @default(now())
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()"))
  cartId    String
  productId String
  name      String
  image     String?
  color     String?
  size      String?
  quantity  Int
  price     Float
  subtotal  Float
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model ExchangeRate {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  usd       Float
  eur       Float
  updatedAt DateTime @updatedAt @default(now())
  createdAt DateTime @default(now())
  date      String   @unique
}

model Settings {
  id                 String   @id @default("global")
  currency           Json?
  shippingMethods    Json?
  paymentMethods     Json?
  updatedAt          DateTime @updatedAt @default(now())
  newProductDuration Int      @default(30)
}

model CartHistory {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  userId        String?
  sessionId     String?
  productId     String
  productName   String
  color         String?
  size          String?
  quantity      Int
  price         Float
  originalPrice Float?
  action        String   // "added", "updated", "removed"
  createdAt     DateTime @default(now())
}

model ProductView {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  productId String
  userId    String?
  sessionId String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model Deployment {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  version     String   @unique
  isActive    Boolean  @default(true)
  deployedAt  DateTime @default(now())
  environment String   @default("development")
  name        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
}
